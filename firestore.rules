rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInWithVerifiedEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return signedInWithVerifiedEmail()
        && request.auth.token.email in [
          'thomasfaudon@thefrenchschool.ca'
        ];
    }

    function accessDoc() {
      return get(/databases/$(database)/documents/access/$(request.auth.token.email));
    }

    function hasCourseAccess(courseId) {
      return signedInWithVerifiedEmail()
        && exists(/databases/$(database)/documents/access/$(request.auth.token.email))
        && (
          courseId == 'A1'
          || (courseId == 'A2' && accessDoc().data.maxLevel in ['A2', 'B1', 'B2'])
          || (courseId == 'B1' && accessDoc().data.maxLevel in ['B1', 'B2'])
          || (courseId == 'B2' && accessDoc().data.maxLevel == 'B2')
        );
    }

    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      match /progress/{setId} {
        allow read, create, update: if request.auth != null && request.auth.uid == userId;
        allow delete: if false;
      }
    }

    match /studentProgress/{email}/sets/{setId} {
      allow read, create, update: if signedInWithVerifiedEmail()
        && request.auth.token.email == email;
      allow delete: if false;
    }

    match /access/{email} {
      allow read: if isAdmin()
        || (signedInWithVerifiedEmail() && request.auth.token.email == email);
      allow create, update: if isAdmin()
        && request.resource.data.email == email
        && request.resource.data.courseLabel is string
        && request.resource.data.maxLevel in ['A1', 'A2', 'B1', 'B2'];
      allow delete: if isAdmin();
    }

    match /config/courseOptions {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /courses/{courseId} {
      allow read: if isAdmin() || hasCourseAccess(courseId);
      allow update: if isAdmin()
        && courseId in ['A1', 'A2', 'B1', 'B2']
        && request.resource.data.id == courseId
        && request.resource.data.label is string
        && request.resource.data.sets is list;
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
